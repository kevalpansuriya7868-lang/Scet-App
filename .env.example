PORT=3000
NODE_ENV=production

# ---- Network guard -------------------------------------------------------
# Comma-separated IPs or CIDRs allowed to call ANY /api route (except /api/health).
ALLOWED_IPS=10.175.212.212
# 0/empty = use the socket address (server directly on the campus LAN).
# Set to the number of reverse-proxy hops you control (e.g. 1 behind nginx) so
# req.ip is derived from X-Forwarded-For safely. Never set "true".
TRUST_PROXY=0

# ---- Firebase --------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Project settings > General > Web API key (used only for password sign-in)
FIREBASE_WEB_API_KEY=

# ---- Auth ------------------------------------------------------------------
# One-time credentials that authorise creating the FIRST admin account only.
MASTER_ADMIN_USERNAME=
MASTER_ADMIN_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=8
FINE_PER_DAY=10

# ---- SMTP (OTP, gate pass, reminders) --------------------------------------
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Web Push Notifications (Phone / PWA) ------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@scet.ac.in
